# ---------------------------------------------------------------------------
# Copy to `.env.local` for local work, and set the same keys in
# Vercel → Settings → Environment Variables for Preview and Production.
# This file is the template only: it is committed and never read at runtime.
# ---------------------------------------------------------------------------

# Canonical origin. Drives canonical URLs, hreflang, sitemap.xml, robots.txt
# and every Open Graph tag. Set this in Vercel → Settings → Environment
# Variables for Production, or shared links will point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://menusyria.com

# The backend the app talks to.
#
# THIS ONE IS A SWITCH, not just an address: `lib/api/client.ts` treats an
# empty value as "no backend yet" and serves every screen from `lib/mock/data`.
# The moment it holds a URL, every service stops mocking and calls that host
# for real — so leave it EMPTY until the API is actually answering, or the
# deployed site will render empty screens and failed requests.
#
# When the backend is ready, set it in Vercel to:
#   https://menusyria.softup.agency/api
#
# No trailing slash: service paths already start with one (`/offers`, and so
# the request becomes https://menusyria.softup.agency/api/offers).
NEXT_PUBLIC_API_URL=

# Google Maps embed key used by the storefront location panel and the
# registration map picker. Restrict it by HTTP referrer to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
